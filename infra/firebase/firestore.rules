rules_version = '2';

// ===========================================================================
// Dedicated Firestore Security Rules for 3DPrintYou / 3DPrintPosters
// Firebase Project: app-3dprintyou, Database: (default)
// ===========================================================================
//
// This rules file is dedicated exclusively to the 3DPrintYou / 3DPrintPosters
// project (`app-3dprintyou`). It is no longer shared with SupplyCloset
// (previously co-hosted on `gen-lang-client-0675309660`).
//
// ===========================================================================
// Assumed Data Model
// ===========================================================================
//
// Client-accessible collections (non-anonymous Firebase Auth accounts only):
//
// Collection: jobs
// Document ID: {jobId} (pattern: ^[a-zA-Z0-9_-]{1,80}$)
// Client access:
//   - read (get & list): owner only (`resource.data.uid == request.auth.uid`).
//     Supports customer queries:
//       where("uid", "==", user.uid), orderBy("updatedAt", "desc"), limit(24)
//   - create: strictly validated initial record (`status == "created"`,
//     owned by caller, strict allowlist & size/path bounds). Note that the
//     production web app creates jobs via the `createGenerationJob` callable
//     (Admin SDK); this rule preserves backward-compatible owner create
//     semantics while preventing schema pollution, privilege forgery, and DoS.
//   - update, delete: denied to clients (managed exclusively by Cloud Functions
//     via Admin SDK).
// Fields (client-creatable subset on `create`):
//   - uid: string (required, must equal request.auth.uid) - owner Auth UID
//   - status: string (required, must equal "created") - initial job status
//   - productType: string (optional, enum: "figurine" | "poster")
//   - selectedStyle: string (optional, 1..120 chars) - chosen workflow style ID
//   - sourceImagePath: string (optional, 1..512 chars, scoped to
//     `uploads/{uid}/{jobId}/{filename}`) - uploaded source image Storage path
//   - createdAt: timestamp (optional, recent <= request.time)
//   - updatedAt: timestamp (optional, recent <= request.time)
// Server-managed fields (written only by Cloud Functions Admin SDK):
//   - pipelineStage, generatedImages, approvedImagePath, figurinePreview,
//     baseConfig, figurineNamedBase, printFileStatus, printFileArtifacts,
//     printability, printFileError, checkoutEligibility,
//     manualCheckoutEligibility, generationState, fulfillmentMode,
//     manualCheckout, workflowConfig, etc.
//
// Collection: orders
// Document ID: {orderId} (matches jobId)
// Client access:
//   - read: owner only (`resource.data.uid == request.auth.uid`).
//   - create, update, delete: denied to clients (server-only via Stripe webhook
//     and Cloud Functions Admin SDK).
// Fields (server-managed):
//   - uid: string (required) - owner Auth UID
//   - jobId: string (required) - associated job document ID
//   - status, paymentStatus, fulfillmentStatus, fulfillment, fulfillmentMode,
//     productType, approvedImagePath, stripeCheckoutSessionId, provider,
//     providerOrderId, priceSnapshot, createdAt, updatedAt
//
// Collection: fulfillmentEvents
// Document ID: {eventId}
// Client access:
//   - read: allowed if non-anonymous authenticated AND referenced
//     `orders/{resource.data.orderId}` exists and belongs to `request.auth.uid`.
//   - create, update, delete: denied to clients (server-only via Admin SDK).
// Fields (server-managed):
//   - orderId: string (required, pattern: ^[a-zA-Z0-9_-]{1,128}$)
//
// Server-only collections (default-denied to all clients; Admin SDK only):
//   - users/{userId}
//   - adminConfig/{configId}
//   - customerContacts/{contactId}
//   - ghlSyncTasks/{taskId}
//   - jobs/{jobId}/supportNotes/{noteId}
//   - jobs/{jobId}/audit/{auditId}
//
// ===========================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // -----------------------------------------------------------------------
    // Helper Functions
    // -----------------------------------------------------------------------

    // Check if the request has any Firebase Auth context.
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if the caller is signed in with a non-anonymous account.
    function hasAccount() {
      return isAuthenticated()
        && request.auth.token.firebase.sign_in_provider != "anonymous";
    }

    // Check if the caller owns an existing document via its `uid` field.
    // Kept concise so Firestore can statically prove `where("uid", "==", uid)`
    // queries.
    function ownsExistingDoc() {
      return hasAccount() && resource.data.uid == request.auth.uid;
    }

    // Check if the caller owns the incoming document via its `uid` field.
    function ownsNewDoc() {
      return hasAccount() && request.resource.data.uid == request.auth.uid;
    }

    // Verify `uid` has not been spoofed on create.
    function uidUnchanged() {
      return !('uid' in request.resource.data)
        || request.resource.data.uid == request.auth.uid;
    }

    // Validate required top-level fields exist on the incoming document.
    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    // Validate the incoming document contains only allowed top-level fields.
    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    // Validate an optional string field is within length bounds when present.
    function isValidOptionalString(field, minLen, maxLen) {
      return !(field in request.resource.data)
        || (request.resource.data[field] is string
          && request.resource.data[field].size() >= minLen
          && request.resource.data[field].size() <= maxLen);
    }

    // Validate a timestamp is within the last 5 minutes and not in the future.
    function isRecent(time) {
      return time is timestamp
        && time > request.time - duration.value(5, 'm')
        && time <= request.time;
    }

    // Validate job/order document IDs against safe path-segment characters.
    function isValidJobId(id) {
      return id is string && id.matches('^[a-zA-Z0-9_-]{1,80}$');
    }

    function isValidOrderId(id) {
      return id is string && id.matches('^[a-zA-Z0-9_-]{1,128}$');
    }

    // Validate a Storage upload path is strictly scoped to caller + jobId.
    function isScopedUploadPath(path, jobId) {
      return path is string
        && path.size() > 0
        && path.size() <= 512
        && isValidJobId(jobId)
        && path.matches(
          '^uploads/' + request.auth.uid + '/' + jobId + '/[a-zA-Z0-9_-]+\\.[a-zA-Z0-9]{1,10}$'
        );
    }

    // -----------------------------------------------------------------------
    // Domain Validators
    // -----------------------------------------------------------------------

    // Validate a client-created initial job document.
    function isValidNewJob(data, jobId) {
      return isValidJobId(jobId)
        && hasRequiredFields(['uid', 'status'])
        && hasOnlyAllowedFields([
          'uid',
          'status',
          'productType',
          'selectedStyle',
          'sourceImagePath',
          'createdAt',
          'updatedAt'
        ])
        && data.uid is string
        && data.uid == request.auth.uid
        && uidUnchanged()
        && data.status is string
        && data.status == 'created'
        && (!('productType' in data) || data.productType in ['figurine', 'poster'])
        && isValidOptionalString('selectedStyle', 1, 120)
        && (!('sourceImagePath' in data) || isScopedUploadPath(data.sourceImagePath, jobId))
        && (!('createdAt' in data) || isRecent(data.createdAt))
        && (!('updatedAt' in data) || isRecent(data.updatedAt));
    }

    // -----------------------------------------------------------------------
    // 3DPrintYou / 3DPrintPosters Collections
    // -----------------------------------------------------------------------

    // Jobs: owner-readable; strictly validated initial create; no client update/delete.
    // Subcollections (e.g., `supportNotes`, `audit`) are not matched here and
    // fall through to the default deny rule below.
    match /jobs/{jobId} {
      allow read: if ownsExistingDoc();
      allow create: if ownsNewDoc()
        && isValidNewJob(request.resource.data, jobId);
      allow update, delete: if false;
    }

    // Orders: owner-readable only; all writes are server-only via Admin SDK.
    match /orders/{orderId} {
      allow read: if ownsExistingDoc();
      allow create, update, delete: if false;
    }

    // Fulfillment events: readable only by the non-anonymous owner of the
    // referenced order; all writes are server-only via Admin SDK.
    match /fulfillmentEvents/{eventId} {
      allow read: if hasAccount()
        && 'orderId' in resource.data
        && isValidOrderId(resource.data.orderId)
        && exists(/databases/$(database)/documents/orders/$(resource.data.orderId))
        && get(/databases/$(database)/documents/orders/$(resource.data.orderId)).data.uid == request.auth.uid;
      allow create, update, delete: if false;
    }

    // -----------------------------------------------------------------------
    // Default Deny
    // -----------------------------------------------------------------------
    // Explicitly denies all client access to everything else, including
    // server-only collections (`users`, `adminConfig`, `customerContacts`,
    // `ghlSyncTasks`) and job subcollections (`jobs/*/supportNotes`,
    // `jobs/*/audit`). Cloud Functions use the Admin SDK and bypass rules.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
